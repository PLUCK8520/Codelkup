# ============================================================
# 环境变量模板
#
# 用法：cp .env.example .env  然后按需修改
# ⚠️ .env 含密码，已在 .gitignore 中排除，**不要提交到版本库**
# ============================================================

# ---------- 前端对外端口 ----------
# 唯一暴露到宿主机的端口。默认 8080。
# ⚠️ 常见坑：8080 可能被 VMware 的 vmnat.exe 占用（本机就是），
#    或被其它本地服务占用。启动前先 `netstat -ano | findstr :8080` 确认，
#    被占用就把这里改成 8090 等空闲端口。
WEB_PORT=8080

# ---------- MySQL ----------
# root 密码：仅用于容器内部探活与运维
MYSQL_ROOT_PASSWORD=change-me-root-password
# 应用库与账号。DB_NAME/DB_USERNAME 有默认值（codelkup），可留空
DB_NAME=codelkup
DB_USERNAME=codelkup
DB_PASSWORD=change-me-app-password

# ---------- JWT ----------
# HS256 要求密钥至少 32 字节（256 位），太短会在启动时抛异常。
# 生成方式（任选）：
#   openssl rand -base64 48
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-at-least-32-bytes-long-random-secret

# ---------- CORS ----------
# 默认用 nginx 同源代理，浏览器不会产生跨域请求，这里通常用不到。
# 只有在"前端直连后端地址"的场景才需要填。
CORS_ALLOWED_ORIGINS=http://localhost:8080

# ---------- 注册开关（本地 compose 演练默认开）----------
# 本地演练要跑 seed-demo（需新建 6 个演示账号），所以默认开着；
# 想演练"关态"（公网建议姿态，注册返回 40304）就改 false 后 `docker compose up -d`（会重建 backend）。
# ⚠️ 顺序：首次灌数据必须开；关掉后再跑 seed 会被 40304 拒掉（详见 deploy/.env.production.example）。
REGISTRATION_ENABLED=true

# ---------- 限流阈值（可选；不填则用 application.yml 默认）----------
# 注册限流按 IP 计、默认 5/小时 —— 而 seed-demo 首次要注册 6 个演示账号（同一 IP），
# 给到 10 避免第 6 个账号撞 42901（真机复验实测）。全部可配键见 application.yml 的 rate-limit 段。
RATE_LIMIT_REGISTER_PER_HOUR=10

# ---------- AI 客户端（M3-4）----------
# 留空 = AI 未启用：相关接口降级返回（"仅检索结果 + 未启用提示"），
# 其余功能完全不受影响。想启用就填自己的 DeepSeek key（形如 sk-xxxx）。
# ⚠️ 不要把这个文件改完就提交 —— 带 key 的 .env 已在 .gitignore 里排除。
AI_ENABLED=true
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# 实现选择（M3-11）：rest（默认，自写 RestClient 版）| spring-ai（框架版，行为一致、多 0.8MB 依赖）
AI_IMPL=rest
# 全站日预算（次/天）：成本闸门的最后一道，超了就直接降级为"仅检索结果"
AI_DAILY_BUDGET=2000
