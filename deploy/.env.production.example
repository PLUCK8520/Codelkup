# ============================================================
# 生产环境变量模板 —— 复制为 .env 后**必须**改掉所有占位值
#
#   cp deploy/.env.production.example .env
#   # 生成强随机密钥：
#   openssl rand -base64 24      # DB / root 密码
#   openssl rand -base64 48      # JWT_SECRET（HS256 要求 ≥32 字节）
#
# ⚠️ .env 已在 .gitignore 中排除，绝不要提交
# ============================================================

# ---------- 对外端口 ----------
# 方案 A（公网 IP 直连）：填 80（需 root/开放 80）或高位端口如 8090
# 方案 B/C（域名 + HTTPS）：保持 80，由 Caddy/Nginx 在前面对接 443
WEB_PORT=80

# ---------- MySQL ----------
# root 仅用于容器内探活与运维；业务账号给后端用。两个都别用弱密码。
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
DB_NAME=codelkup
DB_USERNAME=codelkup
DB_PASSWORD=CHANGE_ME_app_password

# ---------- Redis ----------
# 第四轮审计：Redis 已启 requirepass（此前同一网络内可无认证读写 SSE 票据 /
# 限流桶 / 会话撤销水位）。compose 启动时强制校验本项，缺了直接拒绝启动。
REDIS_PASSWORD=CHANGE_ME_redis_password

# ---------- JWT ----------
# HS256 要求至少 32 字节；太短后端会启动失败（这是有意的 fail-fast）
JWT_SECRET=CHANGE_ME_at_least_32_bytes_random_secret

# ---------- CORS ----------
# 同源部署（前端 nginx 反代 /api）时浏览器不会产生跨域请求，
# 这里填公网 origin 只为"前端直连后端"的调试场景兜底。
CORS_ALLOWED_ORIGINS=https://demo.example.com

# ---------- 注册开关（上线建议关，PRE-MORTEM T0-2）----------
# false：公网演示站被扫到后无法灌垃圾注册；注册接口返回 40304、注册页显示"暂未开放"。
# ⚠️ 首次部署有**顺序要求**（真机复验发现）：seed-demo 要新建 6 个演示账号，
#    而"注册关闭"会把它们全部拒掉（40304）—— 所以第一次上线按这个顺序走：
#      ① 先保持/临时改 REGISTRATION_ENABLED=true
#      ② ./deploy/deploy.sh --seed --verify（灌 6 个演示账号 + 演示帖）
#      ③ 再改回 false → docker compose restart backend（已有账号登录不受影响）
#      ④ 复跑 verify-deploy.py 复核（此时走"关态"分支）
#    之后的重灌（seed 幂等）不受影响 —— 已存在的账号走登录，不再消耗注册额度。
REGISTRATION_ENABLED=false

# ---------- 限流阈值（全部可选；留空即用默认值）----------
# ⚠️ RATE_LIMIT_REGISTER_PER_HOUR 必须 **≥ 演示账号数（6）**：注册限流按 IP 计，
#    首次 seed 的 6 次注册来自同一个 IP，用默认值 5 会让第 6 个账号撞 42901
#    （真机复验实测：seed 中断在 mumu@codelkup.dev）。这里默认给 10 ——
#    对演示站仍是有效反灌水，seed 完成后想收紧回 5 也可以。
# 其余常见调整：共享出口 IP（办公/校园 NAT）被注册限流误伤时调大；演示站可适当放宽互动类。
# 全部可配键与默认值见 codelkup-backend/src/main/resources/application.yml 的 rate-limit 段；
# compose 已显式透传全部 17 个 RATE_LIMIT_*（审计 F4），此处填一个生效一个。
RATE_LIMIT_REGISTER_PER_HOUR=10

# ---------- AI 客户端（M3-4）----------
# 留空 = AI 未启用（接口降级返回"仅检索结果 + 未启用提示"，不影响其它功能）。
# 要做完整演示再填自己的 DeepSeek key；⚠️ 别把填好 key 的 .env 提交进仓库。
AI_ENABLED=true
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# 实现选择（M3-11）：rest（默认，自写 RestClient 版）| spring-ai（框架版）
# 两者读同一份配置、跑同一套验收脚本，切换只影响"谁来发这个请求"
AI_IMPL=rest
# 全站日预算（次/天）：成本闸门的最后一道。配 key 上线前先想清楚这个数 ——
# 超了不是报错，而是全站 AI 问答降级为"仅检索结果"（用户仍可用，只是没有生成答案）
AI_DAILY_BUDGET=2000

# ---------- JVM 堆上限（按服务器内存调）----------
# 容器里的 JVM 默认按宿主机物理内存算堆，2C2G 的机器上极易被 OOM Kill。
# 2C4G → 55；2C2G → 35；4C8G → 60。可用 `docker stats` 观察实际占用再微调。
JVM_MAX_RAM_PERCENTAGE=55