# ============================================================
# Codelkup .gitignore
# ============================================================

# ---------- 环境变量（含密码与密钥，绝不提交）----------
# 用通配而不是逐个点名（第三轮审计）：.env / .env.local / .env.production / .env.bak
# 以及 deploy/ 下同名前缀的变体一律忽略；只有模板（*.example）是交付物，显式放行。
.env
.env.*
!.env.example
deploy/.env*
!deploy/.env.production.example

# ---------- 构建产物 ----------
target/
dist/
build/
node_modules/

# ---------- 运行期数据 ----------
# 上传的头像等文件属于"运行期数据"，不该进版本库
uploads/
# 数据库备份（deploy/backup.py 的默认输出目录）同理：是运行期数据，绝不进版本库
backups/
*.log
logs/

# ---------- Python 字节码缓存 ----------
# deploy/ 与各 verify 脚本是 Python，跑一次就会生成 __pycache__/
__pycache__/
*.pyc

# ---------- Vite 依赖预构建缓存与本地临时文件 ----------
# vite.config.ts 显式把 cacheDir 设到了项目根 .vite-cache（避开 node_modules 被删除拦截），
# 这是缓存，绝不能进版本库。
.vite-cache/
.vite-meta.json
.proxy-ctx.txt
.mod-check.tmp

# ---------- 沙箱环境适配工具（非项目交付物）----------
# forward-proxy.py / fetch-npm-meta.py 是"让 npm/vite 在本机沙箱出口代理下联网"的 hack，
# 依赖该环境特有的代理端口与令牌注入，与项目功能无关，不进版本库。
# ⚠️ 这里必须写 `codelkup/tools/*` 而不是 `codelkup/tools/`：
#    一旦忽略整个目录，Git 就**不会进入该目录**，目录内文件的 `!` 例外规则会失效。
#    而 gen-ep-style-deps.py 是**项目交付物**（vite.config.ts 里 optimizeDeps.include
#    那 118 条 element-plus 样式入口就是它生成的，element-plus 升级后要重跑），
#    必须显式放行，否则别人 clone 下来无法重新生成。
codelkup/tools/*
!codelkup/tools/gen-ep-style-deps.py

# ---------- 编辑器 / IDE ----------
.idea/
.vscode/
*.iml
*.swp

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- AI 助手工作目录 ----------
# .workbuddy 里是会话数据、临时截图、审查中间产物等，
# 不属于项目交付物。其中的 memory/ 是助手的工作笔记，
# 若要保留可单独管理，但不进代码仓库。
.workbuddy/
