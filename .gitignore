# ============================================================
# Codelkup .gitignore
# ============================================================

# ---------- 环境变量（含密码与密钥，绝不提交）----------
.env
.env.local

# ---------- 构建产物 ----------
target/
dist/
build/
node_modules/

# ---------- 运行期数据 ----------
# 上传的头像等文件属于"运行期数据"，不该进版本库
uploads/
*.log
logs/

# ---------- Python 字节码缓存 ----------
# deploy/ 与各 verify 脚本是 Python，跑一次就会生成 __pycache__/
__pycache__/
*.pyc

# ---------- Vite 依赖预构建缓存与本地临时文件 ----------
# vite.config.ts 显式把 cacheDir 设到了项目根 .vite-cache（避开 node_modules 被删除拦截），
# 这是缓存，绝不能进版本库。
.vite-cache/
.vite-meta.json
.proxy-ctx.txt
.mod-check.tmp

# ---------- 沙箱环境适配工具（非项目交付物）----------
# forward-proxy.py / fetch-npm-meta.py 是"让 npm/vite 在本机沙箱代理下联网"的 hack，
# 依赖环境特有的出口代理（127.0.0.1:61191 + 令牌注入），与项目功能无关。
codelkup/tools/

# ---------- 编辑器 / IDE ----------
.idea/
.vscode/
*.iml
*.swp

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- AI 助手工作目录 ----------
# .workbuddy 里是会话数据、临时截图、审查中间产物等，
# 不属于项目交付物。其中的 memory/ 是助手的工作笔记，
# 若要保留可单独管理，但不进代码仓库。
.workbuddy/
